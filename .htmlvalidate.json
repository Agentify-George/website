{
  "extends": ["html-validate:recommended"],
  "rules": {
    "img-alt": "warn",
    "no-dup-id": "warn",
    "title-no-dup": "warn",
    "no-trailing-whitespace": "off",
    "void-style": "off",
    "no-inline-style": "off",
    "doctype-first": "warn",
    "element-name": "off",
    "attr-delimiter": "off",
    "attr-quotes": "off",
    "attribute-allowed-values": "off",
    "attribute-boolean-style": "off",
    "attribute-empty-style": "off",
    "close-attr": "off",
    "close-order": "off",
    "deprecated": "off",
    "element-case": "off",
    "element-permitted-content": "warn",
    "element-permitted-occurrences": "warn",
    "element-permitted-order": "warn",
    "element-required-ancestor": "warn",
    "element-required-attributes": "warn",
    "element-required-content": "warn",
    "empty-heading": "off",
    "empty-title": "off",
    "input-missing-label": "off",
    "meta-refresh": "off",
    "missing-doctype": "off",
    "no-autoplay": "off",
    "no-conditional-comment": "off",
    "no-deprecated-attr": "off",
    "no-dup-class": "off",
    "no-implicit-close": "off",
    "no-missing-references": "off",
    "no-raw-characters": "off",
    "no-redundant-for": "off",
    "no-redundant-role": "off",
    "no-self-closing": "off",
    "no-style-tag": "off",
    "no-unknown-elements": "off",
    "prefer-button": "off",
    "prefer-native-element": "off",
    "prefer-tbody": "off",
    "script-content": "off",
    "script-element": "off",
    "script-type": "off",
    "svg-focusable": "off",
    "text-content": "off",
    "unrecognized-char-ref": "off",
    "valid-id": "off",
    "void-content": "off",
    "wcag/h30": "off",
    "wcag/h32": "off",
    "wcag/h36": "off",
    "wcag/h37": "off",
    "wcag/h67": "off"
  }
}
