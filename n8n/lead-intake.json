                "options": {},
                "bodyJson": "={\n  \"phone_number\": \"{{$json.phone}}\",\n  \"agent_id\": \"RETELL_AGENT_ID\",\n  \"metadata\": {\n    \"lead_id\": \"{{$json.lead_id}}\",\n    \"sheet_row\": \"{{$node[\"Google Sheets - Append Lead\"].json[\"rowNumber\"]}}\"\n  },\n  \"webhook_url\": \"https://YOUR-SUBDOMAIN.n8n.cloud/webhook/retell-callback\"\n}"
            },
            "name": "Retell - Trigger Call",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 1,
            "position": [
